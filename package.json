{
  "name": "studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "NODE_OPTIONS=--conditions=react-server auth generate --yes --output",
    "db:seed": "node --conditions=react-server scripts/seed.ts",
    "format": "biome format --write",
    "test": "playwright test",
    "test:unit": "node --test \"app/**/*.test.ts\"",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@vercel/otel": "2.2.0",
    "better-auth": "1.7.14",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@graphql-typed-document-node/core": "3.2.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "^1.7.14",
    "babel-plugin-react-compiler": "1.0.0",
    "graphql": "17.0.2",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.x"
  }
}
