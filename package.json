    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "^1.7.7",
    "babel-plugin-react-compiler": "1.0.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.x"
  }
